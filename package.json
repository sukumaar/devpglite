{
  "name": "devpglite",
  "version": "0.1.1",
  "description": "A minimal persistent PGlite PostgreSQL-compatible server for local development",
  "keywords": [
    "pglite",
    "postgresql",
    "postgres",
    "local-development",
    "embedded-database",
    "typescript",
    "nodejs",
    "cli"
  ],
  "homepage": "https://github.com/sukumaar/devpglite#readme",
  "bugs": {
    "url": "https://github.com/sukumaar/devpglite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sukumaar/devpglite.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "sukumaar",
    "url": "https://github.com/sukumaar"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "devpglite": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "db": "npm start --",
    "prestart": "npm run build",
    "start": "node --env-file=.env.development dist/cli.js start",
    "pretest": "npm run build && npm run typecheck",
    "test": "vitest run",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@electric-sql/pglite-socket": "0.2.15",
    "signale": "1.4.0",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/signale": "^1.4.7",
    "@types/yargs": "^17.0.35",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
